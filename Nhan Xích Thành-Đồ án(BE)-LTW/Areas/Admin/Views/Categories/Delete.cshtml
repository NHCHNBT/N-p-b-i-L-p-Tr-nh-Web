@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-bg-success fw-bold d-flex justify-content-center">XÓA DANH MỤC</h2>

<div>
    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <hr />
        <div class="form-group d-flex justify-content-center">
            <div class="col-md-offset-2 col-md-10">
                <h4 class="label-danger bg-gradient fw-bold">
                    Bạn thật sự muốn xóa danh mục này ?
                </h4>
            </div>
        </div>
        <div class="form-group d-flex justify-content-center">
            <div class="Control-label col-md-2 col-lg-2 fw-bold">Tên danh mục:</div>
            <div class="col-md-10">
                @Html.DisplayFor(model => model.CategoryName)
            </div>
            </div>
            <br/>
            <div class="form-group d-flex justify-content-center">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Xóa" class="btn btn-default btn-sm btn-primary"/> |
                    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-dark btn-sm" })
                </div>
            </div>
        </div>
            }
        </div>

