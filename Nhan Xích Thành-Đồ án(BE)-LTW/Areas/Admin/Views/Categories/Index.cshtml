@model IEnumerable<Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-bg-success fw-bold d-flex justify-content-center">DANH SÁCH DANH MỤC</h2>


<table class="table bg-info col-md-12 btn-outline-dark">
    <tr>
        <th class="text-dark bg-warning fw-bold"colspan="2">
            @*@Html.DisplayNameFor(model => model.CategoryName)*@
            TÊN DANH MỤC
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td class="col-lg-10">
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                @Html.ActionLink("Cập nhật", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>

    }
    </table>
    
    <p>
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })
    </p>