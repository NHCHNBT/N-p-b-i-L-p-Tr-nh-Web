@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc
<link href="~/Content/myStyle/CustomerDetailProduct.css" rel="stylesheet" />
@if(Model.RelatedProduct != null && Model.RelatedProduct.Any())
            {
                <section class="container-fluid featured-products">
                    <h4 style="font-weight:bold;">Sản phẩm tương tự</h4>
                    <ul class="feature-container">
                        @foreach(var product in Model.RelatedProduct)
                {
                    <li class="fproduct-card">
                        <div>
                            <a href="@Url.Action("Details", "Home", new {id = product.ProductID})">
                                <img src="@Html.DisplayFor(modelItem => product.ImageURL)" />
                            </a>
                        </div>
                        <div>
                            <h5>@Html.DisplayFor(modelItem => product.ProductName) </h5>
                            <p class="prodSale">@Html.DisplayFor(modelItem => product.Price) </p>
                        </div>
                    </li>
                }
                    </ul>
                </section>
            }