@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.ViewModel.HomeProductVM
<link href="~/Content/myStyle/CustomerHome.css" rel="stylesheet" />

@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section class="container-fluid featured-products">
        <h2>Sản phẩm nổi bật</h2>
        <div class="feature-container">
            @foreach(var product in Model.FeaturedProducts)
                {
                    <div class="fproduct-card">
                        <div>
                            <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                                <img src="@Html.DisplayFor(modelItem => product.ImageURL)" />
                            </a>
                        </div>
                        <div>
                            <p class="prodPrice">
                                @Html.DisplayFor(modelItem => product.Price)
                            </p>
                            <p class="prodName">
                                @Html.DisplayFor(modelItem => product.ProductName)
                            </p>
                            <p class="prodCate">
                                @Html.DisplayFor(modelItem => product.Category.CategoryName)
                            </p>
                            <p class="prodSale">
                                Đã bán:&nbsp; @Html.DisplayFor(modelItem => product.OrderDetails.Count)
                            </p>
                        </div>
                    </div>
                }
        </div>

    </section>
        }
