@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    <link href="~/Content/myStyle/CustomerHome.css" rel="stylesheet" />
}

<section class="container-fluid banner">
    <div class="banner-content">
        <p class="banner-subtitle">EXCLUSIVE SMARTPHONES</p>
        <h1 class="banner-title">WELCOME TO TECHPHONE</h1>
        <a href="product.html" class="btn-primary">Shop Now</a>
    </div>
</section>
<section class="container-fluid SearchProd">
    <h2>Tìm kiếm sản phẩm</h2>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="form-group header-search">
            @Html.TextBoxFor(m => m.SearchTerm, new{@class = "search-input",placeholder = "Tìm kiếm sản phẩm... "})
            <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>
    }

</section>
<hr />
@Html.Partial("_PVFeaturedProduct", Model)
@Html.Partial("_PVNewProduct", Model)






