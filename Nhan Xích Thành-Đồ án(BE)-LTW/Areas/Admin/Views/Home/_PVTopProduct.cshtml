@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc
<link href="~/Content/myStyle/CustomerDetailProduct.css" rel="stylesheet" />
@if(Model.TopProducts != null && Model.TopProducts.Any())
            {
                <section class="container-fluid listProduct">
                    <h4 style="font-weight:bold;">Sản phẩm bán chạy</h4>
                    <ul class="list-container">
                        @foreach(var product in Model.TopProducts)
                {
                    <li class="lproduct-card">
                        <div>
                            <a href="@Url.Action("Detail", "Home", new {id = product.ProductID})">
                                <img src="@Html.DisplayFor(modelItem=>product.ImageURL)" />
                            </a>
                        </div>
                        <div>
                            <h5>@Html.DisplayFor(modelItem => product.ProductName)</h5>
                            <p class="prodSale">@Html.DisplayFor(modelItem => product.Price) </p>
                        </div>
                    </li>
                }
                    </ul>
                </section>
                <div class="paignation-container">
                    @Html.PagedListPager(Model.TopProducts,page => Url.Action("Details", new
               {
                   id = Model.products.ProductID,quantity = Model.quantity,page
               }))
                </div>
            }