@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.ViewModel.HomeProductVM
    @using PagedList.Mvc
<link href="~/Content/myStyle/CustomerHome.css" rel="stylesheet" />
@if (Model.NewProducts != null && Model.NewProducts.Any())
            {
                 <section class="container-fluid listProduct">
                     <h2>Sản phẩm mới</h2>
                     <ul class="list-container">
                         @foreach (var product in Model.NewProducts)
                {
                             <li class="lproduct-card">
                                <div>
                                    <a href="@Url.Action("Detail","Home", new {id = product.ProductID})">
                                        <img src="@Html.DisplayFor(modelItem => product.ImageURL)" />
                                    </a>
                                </div>
                                <div>
                                    <p class="prodPrice">@Html.DisplayFor(modelItem => product.Price) </p>
                                    <p class="prodName">@Html.DisplayFor(modelItem => product.ProductName) </p>
                                    <p class="prodSale">Đã bán:&nbsp;@Html.DisplayFor(modelItem => product.Price) </p>
                                </div>
                             </li>
                }
                     </ul>
                 </section>
                 <div class="pagination-container">
                     @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new {page, searchTerm = Model.SearchTerm}))
                 </div>
            }
else
{
<p>Không tìm được sản phẩm nào phù hợp.</p>
}