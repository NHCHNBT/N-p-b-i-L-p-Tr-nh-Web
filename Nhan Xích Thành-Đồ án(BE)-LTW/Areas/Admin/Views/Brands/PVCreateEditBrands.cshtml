@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Brand

<div class="form-group">
    <div class="Control-label col-md-2"> Nhãn hiệu</div>
    <div class="col-md-10">
        @Html.EditorFor(model => model.BrandName, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.BrandName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="Control-label col-md-2">Nước</div> 
    <div class="col-md-10">
        @Html.EditorFor(model => model.Country, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Country, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Lưu" class="btn btn-default" />
        @Html.ActionLink("Quay về danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
    </div>
</div>
