@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Brand

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Xóa nhãn hiệu</h2>


<div>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="dl-horizontal">
            <hr />
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <h4 class="label-danger">
                        Bạn thật sự muốn xóa danh mục này ?
                    </h4>
                </div>
            </div>
            <div class="form-group">
                <div class="Control-label col-md-2">Nhãn hiệu</div>
                <div class="col-md-10">
                    @Html.DisplayFor(model => model.BrandName)
                </div>
            </div>

            <div class="form-group">
                <div class="Control-label col-md-2">Nước</div>
                <div class="col-md-10">
                
                        @Html.DisplayFor(model => model.Country)
                    </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Xóa" class="btn btn-default" /> |
                    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
                </div>
            </div>
                </div>
            </div>
            }
        </div>
