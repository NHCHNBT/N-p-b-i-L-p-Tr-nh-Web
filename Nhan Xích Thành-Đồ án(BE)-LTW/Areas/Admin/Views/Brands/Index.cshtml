@model IEnumerable<Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Brand>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">DANH SÁCH NHÃN HIỆU</h2>



<table class="table bg-info col-lg-12 col-md-6 col-sm-3">

    <tr>
        <th>Nhãn hiệu</th>
        <th>Nước </th>
        <th class="bg-success col-lg-4 col-md-2 col-sm-1"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BrandName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Country)
            </td>
            <td>
                @Html.ActionLink("Chỉnh sửa", "Edit", new { id = item.BrandID }, new { @class = "btn btn-primary btn-sm" })  |
                @Html.ActionLink("Chi tiết", "Details", new { id = item.BrandID }, new { @class = "btn btn-primary btn-sm" })  |
                @Html.ActionLink("Xóa", "Delete", new { id = item.BrandID }, new { @class = "btn btn-primary btn-sm" }) 
            </td>
        </tr>
    }

</table>
<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })
</p>