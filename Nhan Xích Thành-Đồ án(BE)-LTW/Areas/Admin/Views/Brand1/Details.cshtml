@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Brand1

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">THÔNG TIN CHI TIẾT NHÃN HIỆU</h2>

<div>
    <dl class="dl-horizontal">
        <dt>Nhãn hiệu</dt>
        <dd>@Html.DisplayFor(model => model.BrandName)</dd>

        <dt>Nước </dt>
        <dd>@Html.DisplayFor(model => model.Country)</dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Cập nhật", "Edit", new { id = Model.BrandID }, new { @class = "btn btn-primary" }) |
    @Html.ActionLink("Quay về danh sách", "Index", null, new { @class = "btn btn-primary" })
</p>
