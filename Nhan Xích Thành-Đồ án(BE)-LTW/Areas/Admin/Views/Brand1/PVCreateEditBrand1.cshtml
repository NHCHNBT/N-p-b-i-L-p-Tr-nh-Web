@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Brand1

<div class="form-group d-flex justify-content-center">
    <div class="Control-label col-md-2 fw-bold">Nhãn hiệu:</div>
    <div class="col-md-10">
        @Html.EditorFor(model => model.BrandName, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.BrandName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group d-flex justify-content-center">
    <div class="Control-label col-md-2 fw-bold">Nước:</div>
    <div class="col-md-10">
        @Html.EditorFor(model => model.Country, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Country, "", new { @class = "text-danger" })
    </div>
</div>
<br/>
<div class="form-group d-flex justify-content-center">
    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Lưu" class="btn btn-default btn-sm btn-primary" /> |
        @Html.ActionLink("Quay về danh sách", "Index", null, new { @class = "btn btn-dark btn-sm" })
    </div>
</div>

