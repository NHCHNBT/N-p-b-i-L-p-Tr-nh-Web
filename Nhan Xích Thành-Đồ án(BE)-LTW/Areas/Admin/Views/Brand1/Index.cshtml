@model IEnumerable<Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Brand1>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-bg-success fw-bold d-flex justify-content-center">DANH SÁCH NHÃN HIỆU</h2>
<table class="table bg-info col-lg-12 col-md-6 col-sm-3 btn-outline-dark">

    <tr class="fw-bold bg-warning">
        <th>NHÃN HIỆU</th>
        <th colspan="2">NƯỚC</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td class="col-lg-2">
                @Html.DisplayFor(modelItem => item.BrandName)
            </td>
            <td class="col-lg-8">
                @Html.DisplayFor(modelItem => item.Country)
            </td>
            <td>
                @Html.ActionLink("Cập nhật", "Edit", new { id = item.BrandID }, new { @class = "btn btn-primary btn-sm" })  |
                @Html.ActionLink("Xóa", "Delete", new { id = item.BrandID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }

</table>
<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })
</p>