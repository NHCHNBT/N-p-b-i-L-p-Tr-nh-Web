@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.ViewModel.ProductSearchVM
    @using PagedList.Mvc
<head>
    <style>
        img {
            height: 150px;
            max-width: 150px;
        }
    </style>
</head>
@if (Model.Products != null && Model.Products.Any())
{
<h2 class="text-bg-success fw-bold d-flex justify-content-center">DANH SÁCH SẢN PHẨM</h2>

<table class="table bg-info table-responsive">
    <thead>
        <tr>
            <th class="bg-warning col-md-2">Tên sản phẩm</th>
            <th class="bg-warning col-md-2">Mô tả </th>
            <th class="bg-warning col-md-1">Thành tiền</th>
            <th class="bg-warning col-md-1">Số lượng hàng tồn tại thật</th>
            <th class="bg-warning col-md-2">Link hình ảnh sản phẩm</th>
            <th class="bg-warning col-md-1">Số tháng bảo hành</th>
            <th class="bg-warning col-md-1">Nhãn hiệu: </th>
            <th class="bg-warning col-md-1">Tên danh mục</th>
            <th class="bg-warning col-md-4"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Products)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                <td>@Html.DisplayFor(modelItem => item.Description) </td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.StockQuantity)</td>
                <td><img src="@Html.DisplayFor(modelItem => item.ImageURL)" /></td>
                <td>@Html.DisplayFor(modelItem => item.WarrantyMonths)</td>
                <td>@Html.DisplayFor(modelItem => item.Brand.BrandName)</td>
                <td>@Html.DisplayFor(modelItem => item.Category.CategoryName)</td>
                <td>
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="pagination-container d-flex justify-content-center mt-3">
    @Html.PagedListPager(Model.Products,page => Url.Action("Index", new {page, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder}))
</div>
}
else
            {
                <p>Không tìm được sản phẩm nào phù hợp</p>
            }
<div class="form-group">
    <div class="col-md-offset-8 col-md-4">
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    </div>
</div>
