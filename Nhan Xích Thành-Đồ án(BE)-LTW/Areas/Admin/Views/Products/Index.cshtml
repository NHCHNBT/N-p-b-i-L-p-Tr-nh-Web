@model IEnumerable<Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Product>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>

<table class="table bg-info">
    <tr>
        <th class="bg-success col-md-2">
            @*@Html.DisplayNameFor(model => model.ProductName)*@
            Tên sản phẩm
        </th>
        <th class="bg-success col-md-2">
            @*@Html.DisplayNameFor(model => model.Description)*@
            Mô tả 
        </th>
        <th class="bg-success col-md-2">
            @*@Html.DisplayNameFor(model => model.Price)*@
            Thành tiền
        </th>
        <th class="bg-success col-md-2">
            @*@Html.DisplayNameFor(model => model.StockQuantity)*@
            Số lượng hàng tồn tại thật
        </th>
        <th class="bg-success col-md-2">
            @*@Html.DisplayNameFor(model => model.ImageURL)*@
            Link hình ảnh sản phẩm
        </th>
        <th class="bg-success col-md-2">
            @*@Html.DisplayNameFor(model => model.WarrantyMonths)*@
            Số tháng bảo hành
        </th>
        <th class="bg-success col-md-2">
            @*@Html.DisplayNameFor(model => model.Brand.BrandName)*@
            Nhãn hiệu: 
        </th>
        <th class="bg-success col-md-2">
            @*@Html.DisplayNameFor(model => model.Category.CategoryName)*@
            Tên danh mục
        </th>

        <th class="bg-success col-md-4"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StockQuantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImageURL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WarrantyMonths)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Brand.BrandName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.ActionLink("Chỉnh sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }

</table>
<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })
</p>
