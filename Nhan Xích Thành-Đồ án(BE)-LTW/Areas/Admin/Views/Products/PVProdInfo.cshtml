@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Product

<head>
    <style>
        img {
            height: 250px;
            max-width: 250px;
        }
    </style>
</head>
<div class="container-fluid">
    <div class="dl-horizontal">
        <div class="row">
            <div class="col-md-4">
                <img src="@Html.DisplayFor(model => model.ImageURL)" />
            </div>
            <div class="col-md-8 d-flex justify-content-center">
                <dl>
                    <dt class="fw-bold">Tên sản phẩm:</dt>
                    <dd>@Html.DisplayFor(model => model.ProductName)</dd>

                    <dt class="fw-bold">Mô tả:</dt>
                    <dd>@Html.DisplayFor(model => model.Description)</dd>

                    <dt class="fw-bold">Thành tiền:</dt>
                    <dd>@Html.DisplayFor(model => model.Price)</dd>

                    <dt class="fw-bold">Số lương hàng tồn tại thật:</dt>
                    <dd>@Html.DisplayFor(model => model.StockQuantity)</dd>

                    <dt class="fw-bold">Số tháng bảo hành:</dt>
                    <dd>@Html.DisplayFor(model => model.WarrantyMonths)</dd>

                    <dt class="fw-bold">Nhãn hiệu:</dt>
                    <dd>@Html.DisplayFor(model => model.Brand.BrandName)</dd>

                    <dt class="fw-bold">Tên danh mục:</dt>
                    <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>


                </dl>
            </div>
        </div>

    </div>
</div>
