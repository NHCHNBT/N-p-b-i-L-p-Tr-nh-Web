@model Nhan_Xích_Thành_Đồ_án_BE__LTW.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-bg-success fw-bold d-flex justify-content-center">XÓA SẢN PHẨM</h2>

<h4 class="alert-danger fw-bold d-flex justify-content-center">Bạn thật sự muốn xóa sản phẩm này ?</h4>

@Html.Partial("PVProdInfo", Model)

<div class="form-group d-flex justify-content-center">
    <div class="col-md-offset-4 col-md-8">
        @Html.ActionLink("Xóa", "Delete", new { id = Model.ProductID }, new { @class = "btn btn-primary" }) |
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-dark" })
    </div>
</div>
